# Storage Provider Configuration
# Choose: 'local', 'supabase', or 'firebase'
# In dev mode (localhost), defaults to 'local' automatically
VITE_STORAGE_PROVIDER=supabase

# Supabase Configuration (required if using supabase provider)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_BUCKET=your-bucket-name

# Firebase Configuration (required if using firebase provider)
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com
VITE_FIREBASE_API_KEY=your-api-key
